# 枢元智能体操作系统 · 令终服务 init 声明（与 .cfg 对等，按产品 init 框架版本二选一或并存）
service lingzhong_service /system/bin/sa_main /system/profile/9904.xml
    uid system
    gid system
    seclabel u:r:lingzhong_service:s0
    class main
    group system
