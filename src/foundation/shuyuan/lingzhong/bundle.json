            "inner_kits": [
                {
                    "header": {
                        "header_base": "//foundation/shuyuan/lingzhong/interfaces/innerkits/include",
                        "header_files": [
                            "i_lingzhong_service.h",
                            "lingzhong_service_proxy.h"
                        ]
                    },
                    "name": "//foundation/shuyuan/lingzhong:lingzhong_interfaces"
                }
            ],
            "test": []
        }
    }
