# 令终 9904 · 域与服务标签（模板同 lingtai，来源见该文件注释）

type lingzhong_service, sadomain, domain;
type sa_lingzhong, sa_service_attr;

allow init lingzhong_service:process { rlimitinh siginh transition };
allow lingzhong_service samain_exec:file { entrypoint execute map read };
allow lingzhong_service samgr:binder { call transfer };
allow lingzhong_service sa_lingzhong:samgr_class { get add };

allow sh sa_lingzhong:samgr_class get;
allow sh lingzhong_service:binder { call transfer };
