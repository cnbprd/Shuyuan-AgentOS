# 灵台 9901 · 域与服务标签（依据 OpenHarmony security_selinux 实证模板）
# 证据：type.te `type hidumper_service, sadomain, domain;`
#       service.te `type sa_dfx_sys_hidumper_ability, sa_service_attr;`
#       init.te `allow init accesstoken_service:process { rlimitinh siginh transition };`
#       attributes `attribute sa_service_attr;` / `attribute sadomain;`
#       domain.te `neverallow domain default_service:samgr_class *;`

# 进程域（cfg 的 secon: u:r:lingtai_service:s0）
type lingtai_service, sadomain, domain;

# 服务标签（service_contexts: 9901 -> u:object_r:sa_lingtai:s0）
type sa_lingtai, sa_service_attr;

# init 以 secon 拉起本域进程
allow init lingtai_service:process { rlimitinh siginh transition };

# entrypoint 是 /system/bin/sa_main
allow lingtai_service samain_exec:file { entrypoint execute map read };

# 向 samgr 注册/发布 SA
allow lingtai_service samgr:binder { call transfer };
allow lingtai_service sa_lingtai:samgr_class { get add };

# 测试客户端（当前在 sh 域跑 demo_client；正式客户端按实际域名替换）
allow sh sa_lingtai:samgr_class get;
allow sh lingtai_service:binder { call transfer };
