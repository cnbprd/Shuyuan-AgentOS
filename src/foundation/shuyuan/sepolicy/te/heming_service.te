# 和鸣 9903 · 域与服务标签（模板同 lingtai，来源见该文件注释）

type heming_service, sadomain, domain;
type sa_heming, sa_service_attr;

allow init heming_service:process { rlimitinh siginh transition };
allow heming_service samain_exec:file { entrypoint execute map read };
allow heming_service samgr:binder { call transfer };
allow heming_service sa_heming:samgr_class { get add };

allow sh sa_heming:samgr_class get;
allow sh heming_service:binder { call transfer };
