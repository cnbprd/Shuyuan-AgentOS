# 敬止 9905 · 域与服务标签（模板同 lingtai，来源见该文件注释）
# 治理域后续需要审计落盘时，再按实际路径补 file 标签与读写 allow。

type jingzhi_service, sadomain, domain;
type sa_jingzhi, sa_service_attr;

allow init jingzhi_service:process { rlimitinh siginh transition };
allow jingzhi_service samain_exec:file { entrypoint execute map read };
allow jingzhi_service samgr:binder { call transfer };
allow jingzhi_service sa_jingzhi:samgr_class { get add };

allow sh sa_jingzhi:samgr_class get;
allow sh jingzhi_service:binder { call transfer };
