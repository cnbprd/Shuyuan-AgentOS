# 监观 9902 · 域与服务标签（模板同 lingtai，来源见该文件注释）

type jianguan_service, sadomain, domain;
type sa_jianguan, sa_service_attr;

allow init jianguan_service:process { rlimitinh siginh transition };
allow jianguan_service samain_exec:file { entrypoint execute map read };
allow jianguan_service samgr:binder { call transfer };
allow jianguan_service sa_jianguan:samgr_class { get add };

allow sh sa_jianguan:samgr_class get;
allow sh jianguan_service:binder { call transfer };
